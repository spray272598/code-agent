# =============================================================================
# Code-Agent Environment Variables Template
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# =============================================================================

# --- Application Mode ---
# Use mock LLM (no API key required). Set to false for real model calls.
LLM_USE_MOCK=true

# --- LLM Provider (when LLM_USE_MOCK=false) ---
# Your LLM API key (e.g., SiliconFlow, OpenRouter, etc.)
LLM_API_KEY=
# API base URL
LLM_API_BASE=https://api.siliconflow.cn/v1
# Model name
LLM_MODEL=deepseek-ai/DeepSeek-V3

# --- Database ---
DB_TYPE=mysql
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=code_agent

# --- Redis ---
REDIS_ENABLED=true

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Observability ---
OTLP_ENABLED=true
OTLP_ENDPOINT=jaeger:4318

# --- Server ---
# API key for HTTP access (comma-separated for multiple keys)
CODE_AGENT_API_KEY=dev-key
# Server port (inside container)
SERVER_PORT=8080

# --- Orchestrator ---
# Primary agent orchestrator: "eino" or "native"
AGENT_ORCHESTRATOR=eino
# Enable streaming responses
AGENT_STREAM=false
# Eino checkpoint persistence
AGENT_CHECKPOINT_DIR=/data/eino-checkpoints