# =============================================================================
# Code-Agent Environment Variables Template
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to git. Use environment variables or a vault
# for production deployments.
# =============================================================================

# --- Security ---
# JWT signing secret (HS256). Generate with: openssl rand -hex 32
# Required in production. Dev defaults to a hardcoded insecure value.
JWT_SECRET=
# API key for HTTP access (comma-separated for multiple keys)
API_KEY=dev-key

# --- Application Mode ---
# Use mock LLM (no API key required). Set to false for real model calls.
LLM_USE_MOCK=true

# --- LLM Provider (when LLM_USE_MOCK=false) ---
# Your LLM API key (e.g., SiliconFlow, OpenRouter, etc.)
LLM_API_KEY=
# API base URL
LLM_API_BASE=https://api.siliconflow.cn/v1
# Model name
LLM_MODEL=deepseek-ai/DeepSeek-V3

# --- Database ---
DB_TYPE=mysql
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=code_agent

# --- Redis ---
REDIS_ENABLED=true

# --- MinIO (S3-compatible object storage) ---
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# --- Observability ---
OTLP_ENABLED=true
OTLP_ENDPOINT=jaeger:4318

# --- Server ---
# Server port (inside container)
SERVER_PORT=8080

# --- Orchestrator ---
# Primary agent orchestrator: "eino" or "native"
AGENT_ORCHESTRATOR=eino
# Enable streaming responses
AGENT_STREAM=false
# Eino checkpoint persistence
AGENT_CHECKPOINT_DIR=/data/eino-checkpoints
